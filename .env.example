# Copy to .env.local and fill in. Never commit real keys.

# YouTube Data API v3 (videos.list, channels.list)
YOUTUBE_API_KEY=

# Qloo hackathon API (GET /search, GET /v2/insights)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Google Gemini (gemini-3.5-flash): proposes search terms and writes text, never scores
GEMINI_API_KEY=

# Groq (console.groq.com, free): fallback for name extraction when Gemini returns 429/503
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-120b
GROQ_MODEL=
